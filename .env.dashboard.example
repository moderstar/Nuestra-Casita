GROCY_URL=http://grocy:80
GROCY_API_KEY=replace-with-grocy-api-key
CASITA_TIMEZONE=America/Los_Angeles
CASITA_HOUSEHOLD_ID=default
CASITA_HOUSEHOLD_NAME=Nuestra Casita
CASITA_REQUEST_TIMEOUT_SECONDS=10

CASITA_API_PASSWORD=replace-with-a-long-household-password
CASITA_API_SESSION_SECRET=replace-with-at-least-32-random-characters
CASITA_API_SESSION_TTL_SECONDS=86400
CASITA_API_COOKIE_SECURE=1
CASITA_API_ALLOWED_ORIGINS=
CASITA_API_LOG_LEVEL=info

# The browser connects only to this frontend port. Use 0.0.0.0 or the Docker
# VM's LAN IP only after intentionally enabling household-LAN access.
CASITA_FRONTEND_BIND_ADDRESS=127.0.0.1
CASITA_FRONTEND_PORT=8085
